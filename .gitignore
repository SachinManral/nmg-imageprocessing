# ==============================================================================
# Git Ignore - NMG Image Matching System
# ==============================================================================

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/

# --- IDEs & Editors ---
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- Operating System Artifacts ---
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# --- Testing, Profiling & Linting ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Secrets & Environment Variables ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Pipeline Runtime & Output Artifacts ---
output/*
!output/.gitkeep
results/
cache/
.cache/
*.log
*.tmp

# --- Web Frontend & Build Tools (Phase 2) ---
node_modules/
.next/
out/
